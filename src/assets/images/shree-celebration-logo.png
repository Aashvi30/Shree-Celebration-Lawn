<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 180" width="400" height="180">
  <defs>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#C9A84C;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#F5E6C0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#C9A84C;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4A0D1C;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#6B1A2A;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="400" height="180" rx="6" ry="6" fill="url(#bgGrad)"/>

  <!-- Outer border -->
  <rect x="8" y="8" width="384" height="164" rx="4" ry="4"
        fill="none" stroke="#C9A84C" stroke-width="1" opacity="0.5"/>

  <!-- Inner border -->
  <rect x="14" y="14" width="372" height="152" rx="3" ry="3"
        fill="none" stroke="#C9A84C" stroke-width="0.5" opacity="0.3"/>

  <!-- Top decorative line -->
  <line x1="40" y1="38" x2="175" y2="38" stroke="url(#goldGrad)" stroke-width="0.8" opacity="0.7"/>
  <line x1="225" y1="38" x2="360" y2="38" stroke="url(#goldGrad)" stroke-width="0.8" opacity="0.7"/>

  <!-- Top center ornament -->
  <text x="200" y="43" font-family="Georgia, serif" font-size="14"
        fill="#C9A84C" text-anchor="middle" opacity="0.9">✦</text>

  <!-- Corner diamonds -->
  <text x="28" y="43" font-family="Georgia" font-size="10" fill="#C9A84C" opacity="0.6">◆</text>
  <text x="362" y="43" font-family="Georgia" font-size="10" fill="#C9A84C" opacity="0.6">◆</text>

  <!-- Small decorative dots top -->
  <circle cx="55" cy="38" r="1.5" fill="#C9A84C" opacity="0.5"/>
  <circle cx="65" cy="38" r="1" fill="#C9A84C" opacity="0.3"/>
  <circle cx="345" cy="38" r="1.5" fill="#C9A84C" opacity="0.5"/>
  <circle cx="335" cy="38" r="1" fill="#C9A84C" opacity="0.3"/>

  <!-- Main title: Shree -->
  <text x="200" y="90"
        font-family="Georgia, 'Times New Roman', serif"
        font-size="42"
        font-weight="bold"
        fill="url(#goldGrad)"
        text-anchor="middle"
        letter-spacing="8">SHREE</text>

  <!-- Divider ornament row -->
  <text x="200" y="108" font-family="Georgia" font-size="9"
        fill="#C9A84C" text-anchor="middle" letter-spacing="6" opacity="0.8">· · ❋ · ·</text>

  <!-- Sub title: Celebration -->
  <text x="200" y="132"
        font-family="Georgia, 'Times New Roman', serif"
        font-size="26"
        font-weight="normal"
        fill="#E8C96A"
        text-anchor="middle"
        letter-spacing="12">CELEBRATION</text>

  <!-- Bottom line left -->
  <line x1="40" y1="148" x2="155" y2="148" stroke="url(#goldGrad)" stroke-width="0.8" opacity="0.6"/>
  <!-- Bottom line right -->
  <line x1="245" y1="148" x2="360" y2="148" stroke="url(#goldGrad)" stroke-width="0.8" opacity="0.6"/>

  <!-- Tagline -->
  <text x="200" y="145"
        font-family="Arial, sans-serif"
        font-size="8"
        font-weight="normal"
        fill="#C9A84C"
        text-anchor="middle"
        letter-spacing="4"
        opacity="0.85">PREMIER EVENT LAWN</text>

  <!-- Bottom corner ornaments -->
  <text x="28" y="158" font-family="Georgia" font-size="10" fill="#C9A84C" opacity="0.6">◆</text>
  <text x="362" y="158" font-family="Georgia" font-size="10" fill="#C9A84C" opacity="0.6">◆</text>

</svg>
